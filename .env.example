# Порт и адрес сервера. Для доступа из сети или в Docker укажите HOST=0.0.0.0
PORT=3000
HOST=127.0.0.1
# Файл с целью, скоупами и задачами (создаётся автоматически)
DATA_FILE=./data/db.json
# План для первого запуска (если DATA_FILE ещё нет). Храните его вне публичного репозитория
SEED_FILE=
# Логин и пароль для сайта и REST API в формате логин:пароль (обязательно для публичного сервера)
BASIC_AUTH=
# Секрет в адресе MCP-эндпоинта: /mcp/<MCP_SECRET>. Сгенерировать: openssl rand -hex 24
MCP_SECRET=
